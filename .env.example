VERTICAL=lego
COUNTRIES=BE
SITE_URL=https://buildthatset.com

# Zelfgehoste Supabase. SUPABASE_PUBLIC_URL is het adres dat browsers bereiken (voor de afbeeldingen).
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_PUBLIC_URL=https://supabase.example
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Affiliate feeds: de CSV-URL uit je Awin-dashboard per shop
FEED_LEGO_BE=
FEED_MEDIAMARKT_BE=
FEED_DREAMLAND=
FEED_FUN=
FEED_SMYTHS_BE=
# bol Partner Programma: client id en secret via "API Client Credentials aanvragen" in je Affiliate account,
# en het SiteId van je website (uniek per domein)
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
BOL_SITE_ID=

# LEGO.com als officiële shop via Rakuten Advertising (LinkShare): publisher-id onder Links > Deep Links.
# Leeg = gewone lego.com-link zonder affiliate-tracking. LEGO_MID is het merchant id van LEGO bij Rakuten.
RAKUTEN_ID=
LEGO_MID=50641

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=alerts@buildthatset.com

# Zet op 1 voor de demo: voorbeelddata en je eigen foto in web/public/demo, geen Supabase nodig
DEMO=1

# Google Tag Manager (bv. GTM-XXXXXXX). Leeg laten = geen tracking. Met Consent Mode v2 en cookiebanner.
GTM_ID=
