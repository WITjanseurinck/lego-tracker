---
import Base from '@/layouts/Base.astro';
import { articleHeroSet, articlePaths, findArticleById } from '@/lib/articles';
import { getCompareDeal } from '@/lib/deals';
import { formatDate } from '@/lib/format';
import { getI18n } from '@/lib/i18n-server';
import { LOCALE_TAG, localizePath, type Locale } from '@/lib/i18n';
import { pageMeta } from '@/lib/seo';
import { SITE_NAME, SITE_URL } from '@/lib/site';

interface Props { locale: Locale; id: string }
const { locale, id } = Astro.props;
const a = findArticleById(id)!;
const { t, href } = getI18n(locale, articlePaths(a)[locale]);
const x = a.text[locale];
const url = `${SITE_URL}${localizePath(locale, articlePaths(a)[locale])}`;
const hero = getCompareDeal(articleHeroSet(a) ?? '');
const head = pageMeta({
  locale,
  path: articlePaths(a)[locale],
  paths: articlePaths(a),
  title: x.title,
  description: x.summary,
  ogSet: `a-${a.id}`,
  type: 'article',
  publishedTime: a.published,
  modifiedTime: a.updated,
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: x.title,
      description: x.summary,
      inLanguage: LOCALE_TAG[locale],
      // Google Discover wil per artikel beelden in meerdere verhoudingen: 16:9, 4:3, 1:1 en het deelbeeld.
      image: ['', '-16x9', '-4x3', '-1x1'].map((r) => `${SITE_URL}/og/${locale}-a-${a.id}${r}.png`),
      datePublished: a.published,
      dateModified: a.updated,
      mainEntityOfPage: url,
      author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
      publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: `${SITE_URL}${localizePath(locale, '/')}`.replace(/\/$/, '') },
        { '@type': 'ListItem', position: 2, name: t.guides.crumb, item: `${SITE_URL}${localizePath(locale, '/gids')}` },
        { '@type': 'ListItem', position: 3, name: x.title, item: url },
      ],
    },
  ],
};
---
<Base locale={locale} internalPath={articlePaths(a)[locale]} head={head} jsonLd={jsonLd}>
  <article class="wrap page"><div class="prose">
    <nav aria-label={t.guides.crumbAria} class="crumbs"><a href={href('/gids')}>{t.guides.crumb}</a></nav>
    <h1>{x.title}</h1>
    <p class="lead">{x.summary}</p>
    <p class="muted">{t.guides.published(formatDate(a.published, locale))}{formatDate(a.updated, locale) !== formatDate(a.published, locale) ? t.guides.updated(formatDate(a.updated, locale)) : ''}</p>
    {hero?.image ? (
      <figure class="herofig">
        <a href={href(`/set/${hero.set}`)}><img src={hero.image} alt={`LEGO ${hero.set} ${hero.name}`} referrerpolicy="no-referrer" /></a>
        <figcaption><a href={href(`/set/${hero.set}`)}>LEGO {hero.set} {hero.name}</a></figcaption>
      </figure>
    ) : null}
    {x.body.map((b) =>
      'h2' in b ? <h2>{b.h2}</h2>
      : 'ul' in b ? <ul>{b.ul.map((li) => <li>{li}</li>)}</ul>
      : 'src' in b ? <div><h2>{t.guides.sources}</h2><ul>{b.src.map((s) => <li><a href={s.url} target="_blank" rel="noopener nofollow">{s.label}</a></li>)}</ul></div>
      : <p>{b.p}</p>,
    )}
    <aside class="cta-card">
      <h2>{t.guides.ctaTitle}</h2>
      <p>{t.guides.ctaText}</p>
      <a href={href('/')} class="btn dark">{t.guides.ctaButton}</a>
    </aside>
  </div></article>
</Base>
